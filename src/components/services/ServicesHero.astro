---
import PatchBay from './PatchBay.svelte';
import { CONTACT_PATH } from '../../data/site';
---

<section class="hero drench on-honey relative" aria-labelledby="services-title">
  <div class="wrap relative z-10 pt-[clamp(3rem,7vw,6.5rem)]">
    <p class="label section-index text-ink-soft">Services & agents</p>

    <h1 id="services-title" class="display hero-title mt-6">
      Wire up anything <span class="sm:whitespace-nowrap">with an API.</span>
    </h1>

    <div class="mt-10 grid items-start gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-10">
      <div class="hero-copy lg:col-span-5 lg:pt-2">
        <p class="lead">
          Shopify and BigCommerce ship ready to connect. Every other system becomes a custom service, and your
          coding agent can build it for you with the KonnectHub CLI.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={CONTACT_PATH} class="cta-ink">
            Book a build call
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
          <a href="#agents" class="cta-line">Watch an agent build one</a>
        </div>

        <ul class="label mt-10 flex flex-wrap gap-x-5 gap-y-2 text-ink-soft">
          <li>Platform or custom</li>
          <li>Built from your terminal</li>
          <li>Keys never leave KonnectHub</li>
        </ul>
      </div>

      <div class="hero-board lg:col-span-7">
        <PatchBay client:visible />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Same overhang as the home hero: the patch bay hangs into the paper below. */
    --overhang: clamp(5rem, 9vw, 7.5rem);
    background-size: auto, 180px 180px;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: var(--overhang);
    background: var(--color-paper);
    border-top: 2px solid var(--color-ink);
  }

  .hero-title {
    font-size: var(--text-hero);
  }

  .hero-board {
    position: relative;
    z-index: 1;
    padding-bottom: 2rem;
  }

  @media (min-width: 1024px) {
    .hero-copy {
      padding-bottom: calc(var(--overhang) + 2.5rem);
    }

    .hero-board {
      transform: rotate(0.6deg);
    }
  }
</style>
