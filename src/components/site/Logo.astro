---
/**
 * The hexagon-K mark plus wordmark.
 * "ink" tile is for honey backgrounds, where the honey tile would vanish.
 */
interface Props {
  tile?: 'honey' | 'ink';
  class?: string;
}

const { tile = 'honey', class: className = '' } = Astro.props;
const gradientId = `kh-honey-${tile}`;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg viewBox="0 0 40 40" width="32" height="32" aria-hidden="true" class="shrink-0">
    {
      tile === 'honey' ? (
        <>
          <defs>
            <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="oklch(84.5% 0.17 82)" />
              <stop offset="1" stop-color="oklch(74% 0.18 58)" />
            </linearGradient>
          </defs>
          <rect width="40" height="40" rx="8" fill={`url(#${gradientId})`} />
        </>
      ) : (
        <rect width="40" height="40" rx="8" fill="oklch(19% 0.018 60)" />
      )
    }
    <g
      transform="translate(8 8)"
      fill="none"
      stroke={tile === 'honey' ? 'oklch(98.5% 0.008 85)' : 'oklch(84.5% 0.17 82)'}
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M19.875 6.27a2.225 2.225 0 0 1 1.125 1.948v7.284c0 .809 -.443 1.555 -1.158 1.948l-6.75 4.27a2.269 2.269 0 0 1 -2.184 0l-6.75 -4.27a2.225 2.225 0 0 1 -1.158 -1.948v-7.285c0 -.809 .443 -1.554 1.158 -1.947l6.75 -3.98a2.33 2.33 0 0 1 2.25 0l6.75 3.98h-.033"
      ></path>
      <path d="M10 8v8"></path>
      <path d="M14 8l-2.5 4l2.5 4"></path>
      <path d="M10 12h1.5"></path>
    </g>
  </svg>
  <span class="text-[1.375rem] leading-none font-extrabold tracking-[-0.01em] [font-stretch:75%]">KonnectHub</span>
</span>
