---
import RunBoard from './RunBoard.svelte';
import { APP_URL, CONTACT_PATH } from '../../data/site';
---

<section class="hero drench on-honey relative" aria-labelledby="hero-title">
  <div class="wrap relative z-10 pt-[clamp(3rem,7vw,6.5rem)]">
    <p class="label section-index text-ink-soft">Integration runtime for commerce</p>

    <h1 id="hero-title" class="display hero-title mt-6">
      Integrations that <span class="sm:whitespace-nowrap">show their work.</span>
    </h1>

    <div class="mt-10 grid items-start gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-10">
      <div class="hero-copy lg:col-span-5 lg:pt-2">
        <p class="lead">
          KonnectHub runs the flows between Shopify, your ERP, your CRM and everything else. Webhooks,
          schedules and events start them. Every firing is recorded, every run is readable, and nothing
          gets dropped.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={CONTACT_PATH} class="cta-ink">
            Book a build call
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
          <a href={APP_URL} class="cta-line">Start a workspace</a>
        </div>

        <ul class="label mt-10 flex flex-wrap gap-x-5 gap-y-2 text-ink-soft">
          <li>TypeScript or canvas</li>
          <li>Sandboxed workers</li>
          <li>Nothing to host</li>
        </ul>
      </div>

      <div class="hero-board lg:col-span-7">
        <RunBoard client:visible />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    /* The board hangs over the hero's bottom edge into the paper below. */
    --overhang: clamp(5rem, 9vw, 7.5rem);
    padding-bottom: 0;
    background-size: auto, 180px 180px;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: var(--overhang);
    background: var(--color-paper);
    border-top: 2px solid var(--color-ink);
  }

  .hero-title {
    font-size: var(--text-hero);
  }

  .hero-board {
    position: relative;
    z-index: 1;
    padding-bottom: 2rem;
  }

  @media (max-width: 1023.98px) {
    .hero-board {
      margin-top: 0.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-copy {
      padding-bottom: calc(var(--overhang) + 2.5rem);
    }
  }

  @media (min-width: 1024px) {
    .hero-board {
      transform: rotate(-0.6deg);
    }
  }

  /* Only tuck the board up under the headline once the headline is wide enough to clear it. */
  @media (min-width: 1280px) {
    .hero-board {
      margin-top: -4.5rem;
    }
  }
</style>
