---
import { BOOKING_URL } from '../../data/site';

/*
  Zoho's embed.js only clears the parent and appends this same iframe.
  Rendering it directly skips a render-blocking third-party script and works without JS.
  The widget stacks calendar over time slots on narrow screens, so it needs more room there.
*/
const FRAME_HEIGHT = { narrow: 960, wide: 720 } as const;
---

<figure class="booking" aria-labelledby="booking-caption">
  <figcaption class="booking-bar">
    <span class="status" data-status="SUCCEEDED">OPEN</span>
    <span id="booking-caption" class="label whitespace-nowrap text-haze"><span class="hidden sm:inline">Schedule · </span>Video call</span>
    <a href={BOOKING_URL} class="booking-pop label" rel="noopener" target="_blank">
      New tab <span aria-hidden="true">↗</span>
    </a>
  </figcaption>

  <div class="booking-body" style={`--frame-narrow: ${FRAME_HEIGHT.narrow}px; --frame-wide: ${FRAME_HEIGHT.wide}px`}>
    <p class="booking-wait label" aria-hidden="true">Loading calendar…</p>
    <iframe
      src={BOOKING_URL}
      title="Book a build call with KonnectHub"
      height={FRAME_HEIGHT.wide}
      loading="eager"
      allowfullscreen></iframe>
  </div>
</figure>

<style>
  .booking {
    position: relative;
    border: 2px solid var(--color-ink);
    border-radius: 14px;
    background: var(--color-ink);
    box-shadow: 10px 10px 0 0 var(--color-ink);
    overflow: hidden;
  }

  .booking-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--color-ink-3);
  }

  .booking-pop {
    margin-left: auto;
    white-space: nowrap;
    color: var(--color-honey);
    transition: color var(--duration-fast) linear;
  }

  .booking-pop:hover {
    color: var(--color-paper);
  }

  .booking-body {
    --frame-h: var(--frame-narrow);
    position: relative;
    min-height: var(--frame-h);
    background: #fff;
  }

  /* Sits under the iframe; visible only until the calendar paints over it. */
  .booking-wait {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-mute);
  }

  @media (min-width: 768px) {
    .booking-body {
      --frame-h: var(--frame-wide);
    }
  }

  iframe {
    position: relative;
    display: block;
    width: 100%;
    height: var(--frame-h);
    border: 0;
  }
</style>
